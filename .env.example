# Copia este archivo como .env y cambia las contraseñas:
#   cp .env.example .env
# El archivo .env no se sube al repositorio (ver .gitignore).

# Zona horaria usada para calcular vencimientos
TZ=America/Mexico_City

# Puertos publicados en el host
FRONTEND_PORT=8081
MAILPIT_PORT=8025

# MariaDB
DB_PORT=5432
DB_NAME=agenda
DB_USER=agenda_app
DB_PASSWORD=cambia_esta_clave
DB_ROOT_PASSWORD=cambia_esta_clave_root

# Redis
REDIS_PORT=6379
REDIS_PASSWORD=cambia_esta_clave_redis
# Segundos que la lista permanece en caché (mínimo 30)
CACHE_TTL=60

# Correo de prueba (Mailpit)
SMTP_PORT=1025
MAIL_FROM=agenda@practica.local
MAIL_TO=estudiante@practica.local

# Días de anticipación para marcar una actividad como próxima a vencer
DIAS_AVISO=3
